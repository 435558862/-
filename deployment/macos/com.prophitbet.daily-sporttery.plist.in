<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.prophitbet.daily-sporttery</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP_DIR__/.venv/bin/python</string>
    <string>-m</string>
    <string>scripts.daily_sporttery</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__APP_DIR__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>5</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__APP_DIR__/storage/jingcai/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__APP_DIR__/storage/jingcai/launchd.err.log</string>
</dict>
</plist>
